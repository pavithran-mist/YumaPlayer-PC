{
  "name": "yumaplayer-pc",
  "version": "1.4.1",
  "description": "YumaPlayer PC - Hybrid Music & Video Desktop Player created by Pavithran",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "music-player",
    "video-player",
    "youtube-music",
    "flac",
    "electron"
  ],
  "author": "Pavithran",
  "license": "GPL-3.0",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "music-metadata": "^11.1.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pavithran.yumaplayer.pc",
    "productName": "YumaPlayer PC",
    "copyright": "Copyright © 2026 Pavithran",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "YumaPlayer-PC-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "YumaPlayer-PC-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pavithran-mist",
        "repo": "YumaPlayer-PC",
        "releaseType": "release"
      }
    ]
  }
}
